MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d018669f3f177774b9ea54228bfcdfb1, type: 3}
  m_Name: TraiYen_AfterBattle
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  characterASprite: {fileID: 21300000, guid: 7572d1be0af568a4ba864bc345e53ea9, type: 3}
  characterBSprite: {fileID: 21300000, guid: e4ebb96b99b8a5842b6ec71f45b75da0, type: 3}
  portraitWidth: 800
  portraitHeight: 700
  dialogueNodes:
  - speakerName: "Tr\u1EA7n Quang Kh\u1EA3i"
    text: "B\u1EA9m Ti\u1EBFt ch\u1EBF, th\u1EE7y qu\xE2n ta \u0111\xE3 \u0111\xE1nh
      tan c\xE1c \u0111\u1ED3n l\u1EBB \u1EDF ngo\u1EA1i vi. \u0110\u01B0\u1EDDng
      ti\u1EBFn qu\xE2n th\u1EE7y b\u1ED9 ra B\u1EAFc \u0111\xE3 \u0111\u01B0\u1EE3c
      m\u1EDF toang!"
    isCharacterA: 1
  - speakerName: "Tr\u1EA7n Qu\u1ED1c Tu\u1EA5n"
    text: "L\xE0m t\u1ED1t l\u1EAFm. \u0110\u1EA1o binh c\u1EE7a Toa \u0110\xF4 t\u1EEB
      Ngh\u1EC7 An r\xFAt ra c\xF3 \u0111\u1ED9ng t\u0129nh g\xEC kh\xF4ng?"
    isCharacterA: 0
  - speakerName: "Tr\u1EA7n Quang Kh\u1EA3i"
    text: "Ch\xFAng \u0111ang l\xEAnh \u0111\xEAnh d\u1ECDc b\u1EDD bi\u1EC3n t\xECm
      c\xE1ch h\u1ED9i qu\xE2n v\u1EDBi Tho\xE1t Hoan, nhu\u1EC7 kh\xED r\u1EC7u
      r\xE3 v\xF4 c\xF9ng."
    isCharacterA: 1
  - speakerName: "Tr\u1EA7n Qu\u1ED1c Tu\u1EA5n"
    text: "Tuy\u1EC7t \u0111\u1ED1i kh\xF4ng \u0111\u1EC3 ch\xFAng h\u1EE3p qu\xE2n.
      Th\xE1i s\u01B0 h\xE3y \u0111i ti\xEAn phong, chu\u1EA9n b\u1ECB \u0111\xF3n
      \u0111\xE1nh Toa \u0110\xF4 t\u1EA1i c\u1EEDa bi\u1EC3n H\xE0m T\u1EED, T\xE2y
      K\u1EBFt."
    isCharacterA: 0
  - speakerName: "Tr\u1EA7n Quang Kh\u1EA3i"
    text: "L\u0129nh m\u1EC7nh! L\u1EA7n n\xE0y ti\u1EBFn qu\xE2n, th\u1EA7n quy\u1EBFt
      l\u1EA5y \u0111\u1EA7u Toa \u0110\xF4 \u0111\u1EC3 t\u1EBF vong linh d\u0169ng
      s\u0129 \u0110\u1EA1i Vi\u1EC7t!"
    isCharacterA: 1
