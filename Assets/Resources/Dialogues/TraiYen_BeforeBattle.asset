MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d018669f3f177774b9ea54228bfcdfb1, type: 3}
  m_Name: TraiYen_BeforeBattle
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  characterASprite: {fileID: 21300000, guid: 5e95bcb6fc9bce142bff8c284a63cc80, type: 3}
  characterBSprite: {fileID: 21300000, guid: e4ebb96b99b8a5842b6ec71f45b75da0, type: 3}
  portraitWidth: 800
  portraitHeight: 700
  dialogueNodes:
  - speakerName: "Tr\u1EA7n Th\xE1nh T\xF4ng"
    text: "Qu\u1ED1c c\xF4ng Ti\u1EBFt ch\u1EBF, ta lui v\u1EC1 Thanh H\xF3a b\u1EA3o
      to\xE0n l\u1EF1c l\u01B0\u1EE3ng \u0111\xE3 nhi\u1EC1u ng\xE0y. Kh\xED th\u1EBF
      qu\xE2n \u0111\u1ECBch r\u1ED1t cu\u1ED9c \u0111\xE3 ch\u1EEFng l\u1EA1i ch\u01B0a?"
    isCharacterA: 1
  - speakerName: "Tr\u1EA7n Qu\u1ED1c Tu\u1EA5n"
    text: "T\xE2u Th\u01B0\u1EE3ng ho\xE0ng, \u0111\xFAng nh\u01B0 d\u1EF1 li\u1EC7u.
      M\xF9a h\u1EA1 n\u1EAFng n\xF3ng, lam s\u01A1n ch\u01B0\u1EDBng kh\xED, b\u1EC7nh
      d\u1ECBch ho\xE0nh h\xE0nh, th\u1EBF gi\u1EB7c \u0111\xE3 suy y\u1EBFu r\xF5
      r\u1EC7t."
    isCharacterA: 0
  - speakerName: "Tr\u1EA7n Th\xE1nh T\xF4ng"
    text: "V\u1EADy th\u1EDDi c\u01A1 t\u1ED5ng ph\u1EA3n c\xF4ng m\xE0 khanh t\u1EEBng
      n\xF3i... ph\u1EA3i ch\u0103ng \u0111\xE3 \u0111\u1EBFn?"
    isCharacterA: 1
  - speakerName: "Tr\u1EA7n Qu\u1ED1c Tu\u1EA5n"
    text: "D\u1EA1 ph\u1EA3i! Th\u1EA7n \u0111\xE3 m\u1EADt l\u1EC7nh cho c\xE1c
      l\u1ED9 qu\xE2n chu\u1EA9n b\u1ECB. Nay ta s\u1EBD d\u1ED1c to\xE0n l\u1EF1c
      \u0111\xE1nh th\u1ED1c ra B\u1EAFc, gi\xE0nh l\u1EA1i th\u1EBF ch\u1EE7 \u0111\u1ED9ng."
    isCharacterA: 0
  - speakerName: "Tr\u1EA7n Th\xE1nh T\xF4ng"
    text: "Tr\u1EABm giao to\xE0n quy\u1EC1n \u0111i\u1EC1u binh cho khanh. Tr\u1EADn
      n\xE0y, nh\u1EA5t \u0111\u1ECBnh ph\u1EA3i gi\u01B0\u01A1ng cao ng\u1ECDn c\u1EDD
      'S\xE1t Th\xE1t'!"
    isCharacterA: 1
