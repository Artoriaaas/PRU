  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d018669f3f177774b9ea54228bfcdfb1, type: 3}
  m_Name: Opening_HoanChau
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  characterASprite: {fileID: 21300000, guid: 7572d1be0af568a4ba864bc345e53ea9, type: 3}
  characterBSprite: {fileID: 21300000, guid: 9ba36f5f07c5a5d43b092f7ed8d9a9e1, type: 3}
  portraitWidth: 800
  portraitHeight: 700
  dialogueNodes:
  - speakerName: "Toa \u0110\xF4"
    text: "Tr\u1EA7n Quang Kh\u1EA3i! Qu\xE2n \u0110\u1EA1i Nguy\xEAn t\u1EEB Chi\xEAm
      Th\xE0nh \u0111\xE1nh l\xEAn, Th\xE1i t\u1EED Tho\xE1t Hoan \u0111\xE1nh xu\u1ED1ng.
      N\u01B0\u1EDBc Nam c\xE1c ng\u01B0\u01A1i \u0111\xE3 h\u1EBFt \u0111\u01B0\u1EDDng
      lui r\u1ED3i. Kh\xF4n h\u1ED3n th\xEC m\u1EDF \u1EA3i xin h\xE0ng!"
    isCharacterA: 0
  - speakerName: "Tr\u1EA7n Quang Kh\u1EA3i"
    text: "L\xE3o t\u01B0\u1EDBng Toa \u0110\xF4, ng\u01B0\u01A1i c\u1EADy s\u1EE9c
      m\u1EA1nh v\xF3 ng\u1EF1a nh\u01B0ng kh\xF4ng hi\u1EC3u l\xF2ng ng\u01B0\u1EDDi
      Nam. \u0110\u1EA5t Hoan Ch\xE2u n\xE0y s\xF4ng s\xE2u n\xFAi hi\u1EC3m, s\u1EBD
      l\xE0 m\u1ED3 ch\xF4n t\xE0n qu\xE2n c\u1EE7a ng\u01B0\u01A1i!"
    isCharacterA: 1
  - speakerName: "Toa \u0110\xF4"
    text: "Kh\u1EA9u kh\xED l\u1EDBn l\u1EAFm! Tr\u1EA7n Ki\u1EC7n \u0111\xE3 \u0111\u1EA7u
      h\xE0ng, ph\xF2ng tuy\u1EBFn c\u1EE7a c\xE1c ng\u01B0\u01A1i \u0111\xE3 th\u1EE7ng
      l\u1ED7 ch\u1ED7 r\u1ED3i. B\u1EB1ng ch\xFAt binh t\xE0n n\xE0y m\xE0 \u0111\xF2i
      c\u1EA3n ta sao?"
    isCharacterA: 0
  - speakerName: "Tr\u1EA7n Quang Kh\u1EA3i"
    text: "K\u1EBB ph\u1EA3n th\u1EA7n nh\u01B0 Tr\u1EA7n Ki\u1EC7n \u0111\u1EDDi
      \u0111\u1EDDi b\u1ECB nguy\u1EC1n r\u1EE7a, kh\xF4ng \u0111\u1EA1i di\u1EC7n
      cho qu\xE2n d\xE2n \u0110\u1EA1i Vi\u1EC7t. Ta ph\u1EE5ng m\u1EC7nh gi\u1EEF
      \u1EA3i ph\xEDa Nam, d\xF9 th\u1ECBt n\xE1t x\u01B0\u01A1ng tan c\u0169ng kh\xF4ng
      l\xF9i n\u1EEDa b\u01B0\u1EDBc!"
    isCharacterA: 1
  - speakerName: "Toa \u0110\xF4"
    text: "R\u01B0\u1EE3u m\u1EDDi kh\xF4ng u\u1ED1ng l\u1EA1i mu\u1ED1n u\u1ED1ng
      r\u01B0\u1EE3u ph\u1EA1t. \u0110\u1EC3 xem thanh g\u01B0\u01A1m c\u1EE7a ng\u01B0\u01A1i
      c\xF3 c\u1EE9ng h\u01A1n loan \u0111ao M\xF4ng C\u1ED5 kh\xF4ng. Truy\u1EC1n
      l\u1EC7nh, c\xF4ng th\xE0nh!"
    isCharacterA: 0
