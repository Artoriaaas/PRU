  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d018669f3f177774b9ea54228bfcdfb1, type: 3}
  m_Name: ThienTruong_BeforeBattle
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  characterASprite: {fileID: 21300000, guid: 7572d1be0af568a4ba864bc345e53ea9, type: 3}
  characterBSprite: {fileID: 21300000, guid: e4ebb96b99b8a5842b6ec71f45b75da0, type: 3}
  portraitWidth: 800
  portraitHeight: 700
  dialogueNodes:
  - speakerName: "Tr\u1EA7n Qu\u1ED1c Tu\u1EA5n"
    text: "Th\xE1i s\u01B0, ph\u1EE7 Thi\xEAn Tr\u01B0\u1EDDng v\xE0 v\xF9ng duy\xEAn
      h\u1EA3i hi\u1EC7n l\xE0 y\u1EBFt h\u1EA7u th\u1EE7y qu\xE2n gi\u1EB7c. Ng\xE0i
      \u0111\u1ECBnh ph\xE1 ch\xFAng b\u1EB1ng c\xE1ch n\xE0o?"
    isCharacterA: 0
  - speakerName: "Tr\u1EA7n Quang Kh\u1EA3i"
    text: "Th\u1EE7y tr\u1EA1i ch\xFAng ki\xEAn c\u1ED1 nh\u01B0ng c\u1ED3ng k\u1EC1nh.
      Th\u1EA7n s\u1EBD mai ph\u1EE5c \u1EDF hai b\xEAn b\xE3i lau s\u1EADy, \u0111\u1EE3i
      th\u1EE7y tri\u1EC1u r\xFAt xu\u1ED1ng."
    isCharacterA: 1
  - speakerName: "Tr\u1EA7n Qu\u1ED1c Tu\u1EA5n"
    text: "D\xF9ng h\u1ECFa c\xF4ng khi thuy\u1EC1n gi\u1EB7c m\u1EAFc c\u1EA1n sao?
      K\u1EBF n\xE0y r\u1EA5t hi\u1EC3m, nh\u01B0ng ph\u1EA3i ch\u1EDBp \u0111\xFAng
      th\u1EDDi c\u01A1 m\u1EDBi th\xE0nh."
    isCharacterA: 0
  - speakerName: "Tr\u1EA7n Quang Kh\u1EA3i"
    text: "\u0110\xFAng v\u1EADy. Khi thuy\u1EC1n gi\u1EB7c kh\xF4ng th\u1EC3 xoay
      tr\u1EDF, th\u1EA7n s\u1EBD \u0111\xEDch th\xE2n d\u1EABn qu\xE2n c\u1EA3m
      t\u1EED x\xF4ng l\xEAn thi\xEAu r\u1EE5i ch\xFAng."
    isCharacterA: 1
  - speakerName: "Tr\u1EA7n Qu\u1ED1c Tu\u1EA5n"
    text: "Ta \u0111\u1EB7t tr\u1ECDn ni\u1EC1m tin v\xE0o ng\xE0i. Qu\xE9t s\u1EA1ch
      v\xF9ng duy\xEAn h\u1EA3i, \u0111\u01B0\u1EDDng v\u1EC1 Th\u0103ng Long s\u1EBD
      r\u1ED9ng m\u1EDF!"
    isCharacterA: 0
